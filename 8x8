/*
 *  MatrixTicker — ESP32 + MAX7219 4-in-1 LED Stock Scroller
 *  ─────────────────────────────────────────────────────────
 *  Data:    Yahoo Finance (no API key, polling ~20s)
 *  Cloud:   Arduino IoT Cloud — OTA + 3 dashboard variables
 *  Display: MD_Parola / MD_MAX72XX, scrolling marquee
 *
 *  Flicker-free design:
 *    • HTTP fetches run on Core 0 (FreeRTOS task) so the
 *      display loop on Core 1 is never blocked.
 *    • Scroll text is double-buffered; the active buffer is
 *      swapped only at a clean animation-cycle boundary, so
 *      MD_Parola never sees a mid-scroll pointer change.
 *    • All shared state (td[], numTickers, pendingBuf) is
 *      protected by a FreeRTOS mutex.
 *
 *  Wiring (ESP32 → MAX7219):
 *    VCC → VIN   GND → GND
 *    DIN → GPIO23 (MOSI)   CLK → GPIO18 (SCK)   CS → GPIO5
 *
 *  ──────────────────────────────────────────────────────────
 *  Arduino IoT Cloud — create these 3 variables in your Thing:
 *
 *    Name          Type      Permission
 *    ─────────────────────────────────────
 *    tickers       String    Read & Write
 *    scrollSpeed   int       Read & Write
 *    brightness    int       Read & Write
 *
 *  Libraries to add in Cloud IDE (Library Manager):
 *    - ArduinoJson
 *    - MD_Parola
 *    - MD_MAX72XX
 *  ──────────────────────────────────────────────────────────
 */

#include "thingProperties.h"
#include <HTTPClient.h>
#include <ArduinoJson.h>
#include <MD_Parola.h>
#include <MD_MAX72xx.h>
#include <SPI.h>

// ═══════════════════════════════════════════════════════════
//  MAX7219 config
// ═══════════════════════════════════════════════════════════
#define HARDWARE_TYPE MD_MAX72XX::FC16_HW
#define MAX_DEVICES   4
#define CS_PIN        5

MD_Parola matrix = MD_Parola(HARDWARE_TYPE, CS_PIN, MAX_DEVICES);

// ═══════════════════════════════════════════════════════════
//  Custom arrow glyphs  ▲ ▼
// ═══════════════════════════════════════════════════════════
static const uint8_t GLYPH_UP[] = { 5, 0x04, 0x06, 0x3F, 0x06, 0x04 };
static const uint8_t GLYPH_DN[] = { 5, 0x20, 0x60, 0xFC, 0x60, 0x20 };
#define CHR_UP '\x01'
#define CHR_DN '\x02'

// ═══════════════════════════════════════════════════════════
//  Timing
// ═══════════════════════════════════════════════════════════
#define POLL_MS 20000UL

// ═══════════════════════════════════════════════════════════
//  Ticker data
// ═══════════════════════════════════════════════════════════
#define MAX_TICKERS 5

struct TickerData {
  String symbol;
  String label;
  float  price    = 0.0f;
  float  pct      = 0.0f;
  bool   valid    = false;
};

TickerData td[MAX_TICKERS];
int        numTickers = 0;

// ── FreeRTOS concurrency ─────────────────────────────────
//  dataMutex guards: td[], numTickers, pendingBuf, pendingUpdate
static SemaphoreHandle_t dataMutex       = NULL;
static TaskHandle_t      fetchTaskHandle = NULL;

// Double-buffered scroll text.
// fetchTask writes into pendingBuf then sets pendingUpdate = true.
// loop() swaps pendingBuf → activeBuf only at an animation boundary.
static char          activeBuf   [256];
static char          pendingBuf  [256];
static volatile bool pendingUpdate = false;

// ── Forward declarations ─────────────────────────────────
void parseTickers();
void fetchAll();
bool fetchOne(TickerData &t, const String &sym);
void buildScroll();
void fetchTask(void *param);

// ═══════════════════════════════════════════════════════════
//  SETUP
// ═══════════════════════════════════════════════════════════
void setup() {
  Serial.begin(115200);
  delay(500);
  Serial.println("\n── MatrixTicker ──");

  initProperties();
  ArduinoCloud.begin(ArduinoIoTPreferredConnection);

  // Defaults on first boot
  if (tickers.length() == 0)  tickers     = "AMZN.TO,XEQT.TO";
  if (scrollSpeed == 0)       scrollSpeed  = 40;
  if (brightness  <= 0)       brightness   = 4;

  matrix.begin();
  matrix.setIntensity(constrain(brightness, 0, 15));
  matrix.addChar(CHR_UP, GLYPH_UP);
  matrix.addChar(CHR_DN, GLYPH_DN);

  strcpy(activeBuf, "Connecting...");
  matrix.displayText(activeBuf, PA_LEFT, scrollSpeed, 0,
                     PA_SCROLL_LEFT, PA_SCROLL_LEFT);

  // Create mutex before starting the fetch task
  dataMutex = xSemaphoreCreateMutex();
  if (!dataMutex) {
    Serial.println("ERROR: failed to create mutex — halting");
    while (true) delay(1000);
  }

  parseTickers();

  // Fetch task runs on Core 0; display loop stays on Core 1
  if (xTaskCreatePinnedToCore(fetchTask, "FetchTask", 8192, NULL, 1,
                              &fetchTaskHandle, 0) != pdPASS) {
    Serial.println("ERROR: failed to create FetchTask — halting");
    while (true) delay(1000);
  }
}

// ═══════════════════════════════════════════════════════════
//  LOOP  (Core 1 — never blocks, always drives the display)
// ═══════════════════════════════════════════════════════════
void loop() {
  ArduinoCloud.update();

  if (matrix.displayAnimate()) {
    // Swap in the new message only at a clean animation boundary
    // to avoid any mid-scroll visual glitch.
    xSemaphoreTake(dataMutex, portMAX_DELAY);
    if (pendingUpdate) {
      memcpy(activeBuf, pendingBuf, sizeof(activeBuf));
      pendingUpdate = false;
      xSemaphoreGive(dataMutex);
      matrix.displayText(activeBuf, PA_LEFT, scrollSpeed, 0,
                         PA_SCROLL_LEFT, PA_SCROLL_LEFT);
    } else {
      xSemaphoreGive(dataMutex);
      matrix.displayReset();
    }
  }
}

// ═══════════════════════════════════════════════════════════
//  FETCH TASK  (Core 0 — handles all network I/O)
//  Fetches immediately on start, then every POLL_MS, or sooner
//  if woken by xTaskNotifyGive (e.g. from onTickersChange).
// ═══════════════════════════════════════════════════════════
void fetchTask(void *param) {
  while (true) {
    fetchAll();
    buildScroll();
    // Wait up to POLL_MS for an early wake-up notification
    ulTaskNotifyTake(pdTRUE, pdMS_TO_TICKS(POLL_MS));
  }
}

// ═══════════════════════════════════════════════════════════
//  PARSE TICKERS — "AMZN.TO,XEQT.TO" → td[]
// ═══════════════════════════════════════════════════════════
void parseTickers() {
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  numTickers = 0;
  String s = tickers;
  s.trim();

  while (s.length() > 0 && numTickers < MAX_TICKERS) {
    int comma = s.indexOf(',');
    String sym = (comma >= 0) ? s.substring(0, comma) : s;
    sym.trim();
    sym.toUpperCase();

    if (sym.length() > 0) {
      td[numTickers].symbol = sym;
      int dot = sym.indexOf('.');
      td[numTickers].label  = (dot > 0) ? sym.substring(0, dot) : sym;
      td[numTickers].valid  = false;
      numTickers++;
    }
    s = (comma >= 0) ? s.substring(comma + 1) : "";
  }
  xSemaphoreGive(dataMutex);
  Serial.printf("Parsed %d ticker(s)\n", numTickers);
}

// ═══════════════════════════════════════════════════════════
//  FETCH ALL
// ═══════════════════════════════════════════════════════════
void fetchAll() {
  // Snapshot symbol strings under lock so we never hold the mutex
  // across a blocking network call.
  String syms[MAX_TICKERS];
  xSemaphoreTake(dataMutex, portMAX_DELAY);
  int n = numTickers;
  for (int i = 0; i < n; i++) syms[i] = td[i].symbol;
  xSemaphoreGive(dataMutex);

  for (int i = 0; i < n; i++) {
    fetchOne(td[i], syms[i]);
    if (i < n - 1) delay(250);
  }
}

// ═══════════════════════════════════════════════════════════
//  FETCH ONE — Yahoo Finance v8 chart endpoint
//  sym is pre-snapshotted by the caller (fetchAll) under mutex.
// ═══════════════════════════════════════════════════════════
bool fetchOne(TickerData &t, const String &sym) {
  HTTPClient http;
  String url = "https://query1.finance.yahoo.com/v8/finance/chart/"
               + sym + "?interval=1d&range=1d";

  http.begin(url);
  http.addHeader("User-Agent", "ESP32-MatrixTicker/1.0");
  http.addHeader("Accept", "application/json");
  http.setTimeout(8000);

  int code = http.GET();
  if (code != 200) {
    Serial.printf("  [%s] HTTP %d\n", sym.c_str(), code);
    http.end();
    return false;
  }

  JsonDocument filter;
  filter["chart"]["result"][0]["meta"]["regularMarketPrice"] = true;
  filter["chart"]["result"][0]["meta"]["chartPreviousClose"] = true;

  JsonDocument doc;
  DeserializationError err = deserializeJson(
      doc, http.getStream(), DeserializationOption::Filter(filter));
  http.end();

  if (err) {
    Serial.printf("  [%s] JSON: %s\n", sym.c_str(), err.c_str());
    return false;
  }

  JsonObject meta = doc["chart"]["result"][0]["meta"];
  float price     = meta["regularMarketPrice"] | 0.0f;
  float prevClose = meta["chartPreviousClose"] | 0.0f;

  if (price > 0.0f && prevClose > 0.0f) {
    xSemaphoreTake(dataMutex, portMAX_DELAY);
    t.price = price;
    t.pct   = ((price - prevClose) / prevClose) * 100.0f;
    t.valid = true;
    xSemaphoreGive(dataMutex);
    Serial.printf("  [%s] %.2f  %+.1f%%\n", sym.c_str(), price, t.pct);
    return true;
  }
  return false;
}

// ═══════════════════════════════════════════════════════════
//  BUILD SCROLL STRING → pendingBuf
//  Format:  AMZN 28.45 ▲1.3%     XEQT 35.12 ▼0.4%
//  Writes into pendingBuf under mutex and sets pendingUpdate.
//  The display loop will swap it in at the next animation boundary.
// ═══════════════════════════════════════════════════════════
void buildScroll() {
  String msg = "";

  xSemaphoreTake(dataMutex, portMAX_DELAY);
  int n = numTickers;
  for (int i = 0; i < n; i++) {
    if (!td[i].valid) continue;
    if (msg.length() > 0) msg += "     ";

    char arrow = (td[i].pct >= 0.0f) ? CHR_UP : CHR_DN;
    char buf[48];
    snprintf(buf, sizeof(buf), "%s %.2f %c%.1f%%",
             td[i].label.c_str(),
             td[i].price,
             arrow,
             fabsf(td[i].pct));
    msg += buf;
  }
  xSemaphoreGive(dataMutex);

  if (msg.length() == 0) msg = "Waiting for data...";

  msg += "     ";

  xSemaphoreTake(dataMutex, portMAX_DELAY);
  msg.toCharArray(pendingBuf, sizeof(pendingBuf));
  pendingUpdate = true;
  xSemaphoreGive(dataMutex);

  Serial.printf("Scroll ready: %s\n", pendingBuf);
}

// ═══════════════════════════════════════════════════════════
//  CLOUD CALLBACKS
// ═══════════════════════════════════════════════════════════
void onTickersChange() {
  Serial.printf("Cloud > tickers = %s\n", tickers.c_str());
  parseTickers();
  // Wake the fetch task immediately instead of waiting for the next poll
  if (fetchTaskHandle) xTaskNotifyGive(fetchTaskHandle);
}

void onScrollSpeedChange() {
  scrollSpeed = constrain(scrollSpeed, 20, 150);
  matrix.setSpeed(scrollSpeed);
  Serial.printf("Cloud > speed = %d\n", scrollSpeed);
}

void onBrightnessChange() {
  brightness = constrain(brightness, 0, 15);
  matrix.setIntensity(brightness);
  Serial.printf("Cloud > brightness = %d\n", brightness);
}
